<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oxímetro ESP32"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="25dp"/>


        <!-- STATUS DA CONEXÃO -->

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP32 desconectado"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>


        <!-- LED ATUAL -->

        <TextView
            android:id="@+id/txtLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LED atual: --"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>


        <!-- FREQUÊNCIA ATUAL -->

        <TextView
            android:id="@+id/txtFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frequência: 10 Hz"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>


        <!-- CAMPO DE FREQUÊNCIA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frequência de acionamento"
            android:textSize="17sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a frequência"
            android:text="10"
            android:inputType="number"
            android:textSize="20sp"
            android:gravity="center"/>


        <!-- BOTÃO -->

        <Button
            android:id="@+id/btnApplyFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APLICAR FREQUÊNCIA"
            android:layout_marginTop="15dp"/>

    </LinearLayout>

</ScrollView>